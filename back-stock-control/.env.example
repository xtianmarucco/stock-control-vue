PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/DB_NAME
SESSION_SECRET=cambiar-por-un-string-largo-y-aleatorio
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# URL pública del frontend, usada en el link de recuperación de contraseña
FRONTEND_URL=http://localhost:5173

# SMTP para enviar mails. Si SMTP_HOST está vacío, los mails se imprimen en la consola.
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend, SMTP_PASS=<API key>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Stock Control <no-reply@tudominio.com>"
